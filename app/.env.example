# The app no longer ships or uses a built-in Gemini key — AI features use each
# user's own key from Settings. Do not add a key here.
VITE_UPDATE_URL=https://your-app.vercel.app/version.json

# ---- Premium checkout ----
# The checkout BACKEND (PayGate proxy routes + their secrets) lives in the
# Calobit-web repo, deployed at calobit.vercel.app. See its README.
#
# Client override for where /api/checkout/* lives. On a same-origin web deploy
# this is unnecessary; native Android builds fall back to
# https://calobit.vercel.app automatically, so you only need this if the
# backend ever moves to a different domain.
# VITE_CHECKOUT_API_BASE=https://calobit.vercel.app
